# 複製成 .env 放在專案根目錄（.env 已被 .gitignore 排除，絕不進版控）

# ── LLM 供應商：google | anthropic | mock ──
# mock = 演示模式：不需任何 API key，回覆由 RAG 檢索段落規則組裝（見 backend/llm_client.py）
LLM_PROVIDER=mock

# google（Gemma，Google AI Studio）
GOOGLE_API_KEY=
PRIMARY_MODEL=gemma-3-12b-it
SECONDARY_MODEL=gemma-3-12b-it

# anthropic（Claude Sonnet 5）— 啟用時把 LLM_PROVIDER 改成 anthropic
ANTHROPIC_API_KEY=
# PRIMARY_MODEL=claude-sonnet-5

# ── 認證 token 簽章密鑰（正式環境務必設固定值；空則每次啟動隨機，重啟後所有人需重新登入）──
AUTH_SECRET=

# ── 帳號初始化 ──
# 正式環境不會建立任何預設帳號。尚無管理者且 ADMIN_PASSWORD 有值時，啟動會建立第一個管理者。
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=
# 本機遊玩用：true 會植入 P001/R001/A001 示範帳號（start.ps1 已自動開啟）。正式環境請勿設定。
# DEMO_SEED=true

# ── 前端放在別的網域時才需要（逗號分隔）；同網域請留空 ──
CORS_ORIGINS=

# ── LINE Bot（病患端）── 兩者皆有值才啟用 /line/webhook；綁定流程見 README「LINE 病患端」
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 居家病患的緊急指引（LINE 管道使用），請與醫院確認正確號碼
EMERGENCY_CONTACT=請立即撥打 119，或聯絡血液腫瘤科 (02) 8792-7056
