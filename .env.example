# 複製成 .env 放在專案根目錄（.env 已被 .gitignore 排除，絕不進版控）

# ── LLM 供應商：google | anthropic | mock ──
# mock = 演示模式：不需任何 API key，回覆由 RAG 檢索段落規則組裝（見 backend/llm_client.py）
LLM_PROVIDER=mock

# google（Gemma，Google AI Studio）
GOOGLE_API_KEY=
PRIMARY_MODEL=gemma-3-12b-it
SECONDARY_MODEL=gemma-3-12b-it

# anthropic（正式收案）— 把 LLM_PROVIDER 改成 anthropic，PRIMARY_MODEL 二擇一：
#   claude-sonnet-5-5（較快、較便宜）或 claude-opus-5-5
ANTHROPIC_API_KEY=
# PRIMARY_MODEL=claude-sonnet-5-5
# 回答深度（Sonnet 5.5 / Opus 5.5 不接受 temperature）：low | medium | high
# LLM_EFFORT=low
# 模型基於安全政策拒答時，由 API 改用備援模型重跑；IRB 要求只能用單一模型時設 false
# ANTHROPIC_REFUSAL_FALLBACK=true

# ── 知識庫交給模型的方式：auto（預設）| rag（檢索相關段落）| cag（本科全部單張＋prompt caching）──
# auto：LLM 是 Anthropic 且本科單張總字數 ≤ CAG_MAX_CHARS 用 cag，否則 rag。演示模式（mock）一律 rag。
# 依據：docs/knowledge/RAG與CAG比較.md。CAG 快取保存時間 CACHE_TTL：1h（預設）或 5m
# KB_MODE=auto
# CAG_MAX_CHARS=60000
# CACHE_TTL=1h

# ── 檢索嵌入模型（預設 multilingual-e5-small；選項見 backend/embedding.py 的 MODELS）──
# 換模型前先跑 scripts/eval_retrieval.py 比較；換了之後 index_vault.py 會自動重建索引。
# 注意：本機直接執行時 .env 不會自動成為環境變數，要另外 export；Docker 版由 env_file 帶入。
# EMBED_MODEL=multilingual-e5-small

# ── 認證 token 簽章密鑰（正式環境務必設固定值；空則每次啟動隨機，重啟後所有人需重新登入）──
AUTH_SECRET=

# ── 帳號初始化 ──
# 正式環境不會建立任何預設帳號。尚無管理者且 ADMIN_PASSWORD 有值時，啟動會建立第一個管理者。
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=
# 本機遊玩用：true 會植入 P001/R001/A001 示範帳號（start.ps1 已自動開啟）。正式環境請勿設定。
# DEMO_SEED=true

# ── 前端放在別的網域時才需要（逗號分隔）；同網域請留空 ──
CORS_ORIGINS=

# ── LINE Bot（病患端）── 兩者皆有值才啟用 /line/webhook；綁定流程見 README「LINE 病患端」
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 居家病患的緊急指引（LINE 管道使用），請與醫院確認正確號碼
EMERGENCY_CONTACT=請立即撥打 119，或聯絡血液腫瘤科 (02) 8792-7056
